# PostgreSQL local. Defina uma senha própria no arquivo .env.
POSTGRES_DB=ai_assistant
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Use "mock" sem chave ou "openai" para integração real
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=30s
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_COMPLETION_TOKENS=512
AI_SYSTEM_PROMPT=You are a helpful, concise and respectful virtual assistant.

# Opcional para ambientes implantados
# DATABASE_URL=jdbc:postgresql://localhost:5432/ai_assistant
# JPA_DDL_AUTO=validate
