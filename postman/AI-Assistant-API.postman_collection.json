{
  "info": {
    "_postman_id": "51d62d09-c595-43af-a669-eb89eaf09135",
    "name": "AI Assistant API",
    "description": "Collection para executar o ciclo principal da AI Assistant API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "conversationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create conversation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const response = pm.response.json();",
              "pm.collectionVariables.set('conversationId', response.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Conversation from Postman\"\n}"
        },
        "url": "{{baseUrl}}/conversations"
      }
    },
    {
      "name": "List conversations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/conversations"
      }
    },
    {
      "name": "Get conversation",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/conversations/{{conversationId}}"
      }
    },
    {
      "name": "Send message",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Assistant answered', () => pm.expect(pm.response.json().assistantMessage.content).to.be.a('string').and.not.empty);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Explain dependency injection in simple terms.\"\n}"
        },
        "url": "{{baseUrl}}/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "List messages",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/conversations/{{conversationId}}/messages"
      }
    },
    {
      "name": "Delete conversation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/conversations/{{conversationId}}"
      }
    }
  ]
}
